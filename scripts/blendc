#!/usr/bin/env python3

import sys


def parse(arg):
    if len(arg) not in (3, 4, 6, 8) or any(
        c not in "0123456789abcdefABCDEF" for c in arg
    ):
        sys.exit(f"error: invalid hex color: {arg}")
    if len(arg) < 6:
        arg = "".join(c * 2 for c in arg)
    return [int(arg[i : i + 2], 16) for i in range(0, len(arg), 2)]


def main():
    if len(sys.argv) < 2:
        sys.exit("error: no colors given")
    colors = [parse(a) for a in sys.argv[1:]]
    if len({len(c) for c in colors}) > 1:
        sys.exit("error: cannot mix RGB and RGBA colors")
    n = len(colors[0])
    avg = [round(sum(c[i] for c in colors) / len(colors)) for i in range(n)]
    print("#" + "".join(f"{v:02x}" for v in avg))


if __name__ == "__main__":
    main()
