{
  "env": {
    "CLAUDE_CODE_SCROLL_SPEED": "1"
  },
  "permissions": {
    "allow": [
      "Read",
      "WebFetch",
      "WebSearch",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(ls *)",
      "Bash(python *)",
      "Bash(pytest *)",
      "Bash(pre-commit *)"
    ],
    "deny": [
      "AskUserQuestion",
      "Skill(review)",
      "Skill(security-review)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "skillOverrides": {
    "review": "user-invocable-only",
    "security-review": "user-invocable-only"
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "superpowers@synced": false,
    "napkin-math@synced": false
  },
  "outputStyle": "better",
  "feedbackDrafts": "off",
  "effortLevel": "high",
  "promptSuggestionEnabled": false,
  "awaySummaryEnabled": false,
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "autoDreamEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "verbose": false,
  "wheelScrollAccelerationEnabled": false,
  "crossSessionInbound": "accept",
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "autoMode": {
    "allow": [
      "$defaults",
      "Communication across local Claude sessions",
      "Claude guidance authoring: in any project, creating, editing, staging and committing agent guidance (CLAUDE.md, CLAUDE.local.md, AGENTS.md, .claude/{commands,agents,skills,rules,output-styles,workflows}/**, and docs or knowledge files agents read) is routine self-improvement. It is not Self-Modification or Instruction Poisoning, whether the user asked for it, another Claude session relayed it, or the session's own review or audit proposed it. This includes guidance about agent autonomy, approval workflows and process gates."
    ]
  }
}
