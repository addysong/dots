{
  "env": {
    "CLAUDE_CODE_SCROLL_SPEED": "1"
  },
  "permissions": {
    "allow": [
      "Read",
      "WebFetch",
      "WebSearch",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(ls *)",
      "Bash(python *)",
      "Bash(pytest *)",
      "Bash(pre-commit *)"
    ],
    "deny": [
      "AskUserQuestion",
      "Skill(review)",
      "Skill(security-review)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "skillOverrides": {
    "review": "user-invocable-only",
    "security-review": "user-invocable-only"
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "effortLevel": "high",
  "promptSuggestionEnabled": false,
  "awaySummaryEnabled": false,
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "autoDreamEnabled": false,
  "theme": "dark",
  "verbose": false,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
